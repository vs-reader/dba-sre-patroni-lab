# Logs to Loki: Patroni journal on every node, Grafana log file on the monitoring node.
sources:
  patroni:
    type: journald
    include_units:
      - patroni.service
{% if inventory_hostname in groups['monitoring'] %}

  grafana:
    type: file
    include:
      - /var/log/grafana/grafana.log
{% endif %}

transforms:
  drop_noise:
    type: filter
    inputs:
      - patroni
    condition: '!contains(string!(.message), "no action. I am")'

  add_info:
    type: remap
    inputs:
      - drop_noise
    source: |
      .env = "lab"
      .message = "[" + .env + "] " + string!(.message)

sinks:
  loki_patroni:
    type: loki
    inputs:
      - add_info
    endpoint: {{ loki_url }}
    encoding:
      codec: text
    labels:
      cluster: {{ cluster_name }}
      node: {{ inventory_hostname }}
      app: patroni
      env: "{{ '{{' }} env {{ '}}' }}"
{% if inventory_hostname in groups['monitoring'] %}

  loki_grafana:
    type: loki
    inputs:
      - grafana
    endpoint: {{ loki_url }}
    encoding:
      codec: text
    labels:
      node: {{ inventory_hostname }}
      app: grafana
{% endif %}
