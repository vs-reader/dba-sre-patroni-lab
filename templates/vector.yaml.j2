# Patroni, PostgreSQL and role-event lines from journald to Loki.
sources:
  patroni_journal:
    type: journald
    include_units:
      - patroni.service

transforms:
  parse:
    type: remap
    inputs:
      - patroni_journal
    source: |
      line = string!(.message)
      component = "patroni"
      level = "INFO"
      if .SYSLOG_IDENTIFIER == "patroni-role" {
        component = "role-event"
        if contains(line, "failed") { level = "WARNING" }
      } else if match(line, r'^\d{4}-\d\d-\d\d \d\d:\d\d:\d\d\.\d+ \w+ \[\d+\]') {
        component = "postgresql"
        level = parse_regex(line, r'\] (?P<lvl>[A-Z]+):').lvl ?? "LOG"
      } else {
        level = parse_regex(line, r'^\S+ \S+ (?P<lvl>[A-Z]+):').lvl ?? "INFO"
      }
      event = {
        "timestamp": .timestamp,
        "message": line,
        "cluster": "{{ cluster_name }}",
        "node": "{{ inventory_hostname }}",
        "component": component,
        "level": level
      }
      slow, err = parse_regex(line, r'duration: (?P<ms>[\d.]+) ms')
      if err == null {
        event.duration_ms = to_float!(slow.ms)
      }
      . = event

  drop_noise:
    type: filter
    inputs:
      - parse
    condition: '!contains(string!(.message), "no action. I am")'

sinks:
  loki:
    type: loki
    inputs:
      - drop_noise
    endpoint: {{ loki_url }}
    encoding:
      codec: json
    remove_label_fields: true
    labels:
      cluster: "{{ '{{' }} cluster {{ '}}' }}"
      node: "{{ '{{' }} node {{ '}}' }}"
      component: "{{ '{{' }} component {{ '}}' }}"
      level: "{{ '{{' }} level {{ '}}' }}"
